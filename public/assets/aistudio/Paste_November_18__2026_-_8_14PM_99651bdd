    // 1. TAB ROUTING & GLOBAL SEARCH
    function switchTab(tabId) {
      document.querySelectorAll('.tab-section').forEach(s => s.classList.add('hidden'));
      const active = document.getElementById('tab-' + tabId);
      if (active) active.classList.remove('hidden');

      document.querySelectorAll('.nav-btn').forEach(btn => {
        const isTarget = btn.dataset.tab === tabId;
        if (isTarget) {
          btn.className = 'nav-btn px-3 py-2 rounded-xl transition flex items-center gap-1.5 bg-white text-deepNavy-950 font-bold';
        } else if (btn.dataset.tab === 'dcongress') {
          btn.className = 'nav-btn px-3 py-2 rounded-xl transition flex items-center gap-1.5 text-sweYellow hover:bg-white/10';
        } else {
          btn.className = 'nav-btn px-3 py-2 rounded-xl transition flex items-center gap-1.5 text-slate-300 hover:bg-white/10 hover:text-white';
        }
      });

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function toggleMobileMenu() {
      document.getElementById('mobileNav').classList.toggle('hidden');
    }

    function handleGlobalSearch(e) {
      if (e.key !== 'Enter') return;
      const q = e.target.value.trim().toLowerCase();
      if (!q) return;
      executeSmartSearch(q);
    }

    function runHeroSearch() {
      const q = document.getElementById('heroSearch').value.trim().toLowerCase();
      if (!q) {
        switchTab('ehandlare');
        return;
      }
      executeSmartSearch(q);
    }

    function executeSmartSearch(q) {
      if (q.includes('congress') || q.includes('mässa') || q.includes('talare') || q.includes('biljett')) {
        switchTab('dcongress');
        showToast('Visar D-Congress 2027 i Göteborg');
      } else if (q.includes('klarna') || q.includes('swish') || q.includes('centra') || q.includes('partner') || q.includes('logistik')) {
        switchTab('partners');
        showToast('Visar matchande Tech & Partners');
      } else if (q.includes('pixel') || q.includes('historia') || q.includes('90-tal') || q.includes('ai')) {
        switchTab('historia');
        showToast('Visar tidslinjen Från Pixlar till AI');
      } else if (q.includes('community') || q.includes('nätverk') || q.includes('slack')) {
        switchTab('community');
        showToast('Välkommen till Sveriges E-handel Network');
      } else {
        switchTab('ehandlare');
        document.getElementById('merchantSearch').value = q;
        renderMerchants();
        showToast(`Sökte efter "${q}" bland svenska e-handlare`);
      }
    }

