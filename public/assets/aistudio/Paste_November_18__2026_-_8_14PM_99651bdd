      `).join('');
    }

    // 8. TECH & PARTNERS
    const partnersData = [
      { name: 'Centra', cat: 'E-handelsplattform', origin: 'Stockholm', stack: 'Headless • Global D2C & B2B', desc: 'Marknadsledande headless-plattform för mode- och livsstilsvarumärken som skalar globalt.' },
      { name: 'Klarna', cat: 'Betalning & Checkout', origin: 'Stockholm', stack: 'BNPL • Direktbetalning • AI', desc: 'Global betalningsjätte som driver konvertering för över 500 000 handlare världen över.' },
      { name: 'Swish Handel', cat: 'Betalning & Checkout', origin: 'Stockholm', stack: 'Mobilt BankID • Direktbetalning', desc: 'Sveriges snabbaste mobila betalsätt med över 8,5 miljoner anslutna användare.' },
      { name: 'Ingrid', cat: 'Logistik & Last-mile', origin: 'Stockholm', stack: 'Delivery Checkout • Tracking', desc: 'Intelligent fraktväljare och leveransplattform som optimerar marginal och kundupplevelse.' },
      { name: 'Instabox / Budbee', cat: 'Logistik & Last-mile', origin: 'Stockholm', stack: 'Paketskåp • Fossilfri hemleverans', desc: 'Nordens tätaste nätverk av smarta paketskåp och kvällsleveranser med eldrivna fordon.' },
      { name: 'Voyado', cat: 'MarTech & AI', origin: 'Norrköping', stack: 'CDP • CRM • AI-personalisering', desc: 'Nordisk kunddataplattform och lojalitetsmotor byggd specifikt för retail och e-handel.' }
    ];

    function filterPartners(cat) {
      document.querySelectorAll('.partner-cat-btn').forEach(btn => {
        if (btn.dataset.pcat === cat) {
          btn.className = 'partner-cat-btn px-4 py-2 rounded-xl text-xs font-bold bg-sweYellow text-deepNavy-950';
        } else {
          btn.className = 'partner-cat-btn px-4 py-2 rounded-xl text-xs font-bold bg-white/10 hover:bg-white/20 text-white';
        }
      });

      const list = cat === 'all' ? partnersData : partnersData.filter(p => p.cat === cat);
      document.getElementById('partnersGrid').innerHTML = list.map(p => `
        <div class="bento-card p-6 flex flex-col justify-between space-y-4">
          <div>
            <div class="flex items-center justify-between text-xs mb-2">
              <span class="font-mono font-bold text-sweBlue bg-sweBlue-light px-2.5 py-0.5 rounded-lg">${p.cat}</span>
              <span class="font-mono text-slate-400"><i class="fa-solid fa-location-dot mr-1"></i>${p.origin}</span>
            </div>
            <h3 class="font-display text-2xl font-extrabold text-deepNavy-950">${p.name}</h3>
            <div class="font-mono text-[11px] text-nordicGreen-600 font-bold mt-1">${p.stack}</div>
            <p class="text-xs sm:text-sm text-slate-600 mt-2.5 leading-relaxed">${p.desc}</p>
          </div>
          <button onclick="openModal('Kontakta ${p.name}', 'Ange din e-post så kopplar vi ihop dig med rätt partneransvarig hos ${p.name}.')"
            class="self-start text-xs font-bold text-deepNavy-950 hover:text-sweBlue transition">
            Begär partnerintro &rarr;
          </button>
        </div>
      `).join('');
    }

    // 9. COMMUNITY FEED & UPVOTES
    let communityThreads = [
      { id: 1, channel: '#ai-och-data', author: 'Erik S. • E-commerce Manager (Göteborg)', title: 'Resultat efter 90 dagar med Meta Server-Side CAPI + första-parts kunddata: +19% attribuerad ROAS', votes: 42, replies: 16, time: '2h sedan' },
      { id: 2, channel: '#export-tull', author: 'Sofia L. • Grundare (Borås)', title: 'Bästa upplägget för returer från Tyskland & Norge utan att äta upp bruttomarginalen?', votes: 31, replies: 11, time: '4h sedan' },
      { id: 3, channel: '#d-congress-2027', author: 'Johan K. • Head of Tech (Stockholm)', title: 'Vilka bokar middag i Göteborg kvällen före D-Congress 10 mars 2027? Vi samlar 30 handlare!', votes: 54, replies: 23, time: 'Idag' },
      { id: 4, channel: '#checkout-optimering', author: 'Hanna B. • Growth Lead (Malmö)', title: 'A/B-test: Swish som förvalt betalsätt i mobilen ökade checkout-completion med 6,4%', votes: 38, replies: 9, time: 'Igår' }
    ];
    let activeChannel = 'all';

    function filterChannel(ch) {
      activeChannel = ch;
      document.querySelectorAll('.ch-btn').forEach(btn => {
        if (btn.dataset.ch === ch) {
          btn.className = 'ch-btn w-full text-left px-3 py-2 rounded-xl bg-deepNavy-950 text-white';
        } else {
          btn.className = 'ch-btn w-full text-left px-3 py-2 rounded-xl text-slate-700 hover:bg-slate-100';
        }
      });
      renderCommunityFeed();
    }

    function renderCommunityFeed() {
      const list = activeChannel === 'all' ? communityThreads : communityThreads.filter(t => t.channel === activeChannel);
      document.getElementById('communityFeedList').innerHTML = list.map(t => `
        <div class="p-4 rounded-2xl border border-slate-200 hover:border-sweBlue/50 transition flex items-start gap-4">
          <button onclick="upvoteThread(${t.id})" class="shrink-0 flex flex-col items-center justify-center w-12 py-2 rounded-xl bg-slate-50 hover:bg-sweYellow/30 border border-slate-200 transition">
            <i class="fa-solid fa-caret-up text-deepNavy-950"></i>
            <span class="font-mono text-xs font-extrabold text-deepNavy-950">${t.votes}</span>
          </button>
          <div class="flex-1 space-y-1.5">
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span class="font-mono font-bold text-sweBlue bg-sweBlue-light px-2 py-0.5 rounded">${t.channel}</span>
              <span class="text-slate-400">•</span>
              <span class="text-slate-500 font-medium">${t.author}</span>
              <span class="text-slate-400 text-[11px]">${t.time}</span>
            </div>
            <h4 class="font-display font-bold text-sm sm:text-base text-deepNavy-950">${t.title}</h4>
            <div class="text-xs text-slate-500 font-semibold">
              <i class="fa-regular fa-comment mr-1"></i> ${t.replies} kommentarer i tråden
            </div>
          </div>
        </div>
      `).join('');
    }

    function upvoteThread(id) {
      const item = communityThreads.find(t => t.id === id);
      if (item) {
        item.votes += 1;
        renderCommunityFeed();
      }
    }

    function addCommunityPost(e) {
      e.preventDefault();
      const input = document.getElementById('newPostTitle');
      const channel = document.getElementById('newPostChannel').value;
      if (!input.value.trim()) return;

      communityThreads.unshift({
        id: Date.now(),
        channel,
        author: 'Du • Verifierad Medlem',
        title: input.value.trim(),
        votes: 1,
        replies: 0,
        time: 'Just nu'
      });
      input.value = '';
      renderCommunityFeed();
      showToast('Din tråd har publicerats i nätverket!');
    }

    function handleCommunityJoin(e) {
      e.preventDefault();
      const name = document.getElementById('joinName').value;
      const city = document.getElementById('joinCity').value;
      e.target.reset();
      showToast(`Tack ${name}! Inbjudan till Sveriges E-handel Network (${city}) är skickad.`);
    }

    // 10. MODAL & TOAST
    function openModal(title, body) {
      document.getElementById('modalTitle').textContent = title;
      document.getElementById('modalBody').textContent = body;
      document.getElementById('customModal').classList.remove('hidden');
    }
    function closeModal() {
      document.getElementById('customModal').classList.add('hidden');
    }
    function confirmModal() {
      closeModal();
      showToast('Bekräftat! Information har skickats till din e-post.');
    }
    function showToast(msg) {
      const t = document.getElementById('toast');
      document.getElementById('toastText').textContent = msg;
      t.classList.remove('hidden');
      setTimeout(() => t.classList.add('hidden'), 3800);
    }

    // INIT ON LOAD
    window.addEventListener('DOMContentLoaded', () => {
      selectRegion('vast');
      setTradeMode('export');
      setDemoTab('generations');
      filterDCSessions('all');
      renderMySchedule();
      setTimeMachine('1998');
      filterTimeline('all');
      renderMerchants();
      filterPartners('all');
      renderCommunityFeed();
    });
  </script>
</body>
</html>