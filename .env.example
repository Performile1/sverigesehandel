# Firebase web config, project ID and named database ID are already provided by
# firebase-applet-config.json. Google login uses that same Firebase Auth instance.
# Only server-side credentials are needed on Vercel. Never prefix with VITE_.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: only used by the protected AI discovery/enrichment endpoints.
GEMINI_API_KEY=

# Optional: enables automatic forwarding/notification emails via Resend on form & intro submissions.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Firebase CMS features: OFF until billing/configuration/privacy approval.
# Bucket and GA4 property are explicit server targets; nothing is provisioned.
CMS_FIREBASE_MEDIA_ENABLED=false
CMS_FIREBASE_STORAGE_BUCKET=
CMS_GA4_REPORTS_ENABLED=false
CMS_GA4_PROPERTY_ID=
# No collection, raw-IP or heatmap flag exists in this implementation.
